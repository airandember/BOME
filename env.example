# Database Configuration
DB_PASSWORD=your_secure_database_password_here

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-here
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Bunny.net Configuration
BUNNY_API_KEY=your_bunny_api_key
BUNNY_STORAGE_ZONE=your_storage_zone
BUNNY_PULL_ZONE=your_pull_zone
BUNNY_STREAM_LIBRARY_ID=your_stream_library_id
BUNNY_STREAM_API_KEY=your_stream_api_key
BUNNY_REGION=de

# Digital Ocean Spaces Configuration
DO_SPACES_KEY=your_spaces_key
DO_SPACES_SECRET=your_spaces_secret
DO_SPACES_ENDPOINT=nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=your_bucket_name
DO_SPACES_REGION=nyc3

# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@bookofmormonevidence.org
SENDGRID_FROM_NAME=Book of Mormon Evidences

# Admin Configuration
ADMIN_EMAIL=admin@bookofmormonevidence.org
ADMIN_PASSWORD=change_this_in_production
ADMIN_SECRET_KEY=your-admin-secret-key

# Security Configuration
CSRF_SECRET=your-csrf-secret-key
SESSION_SECRET=your-session-secret-key
BCRYPT_COST=12

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_BURST=20

# File Upload
MAX_FILE_SIZE=100MB

# Logging
LOG_LEVEL=info

# Metrics
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_ENDPOINT=/health

# Frontend Configuration
VITE_API_BASE_URL=${VITE_API_BASE_URL:-http://localhost:8080/api/v1}
VITE_APP_NAME=Book of Mormon Evidence
VITE_APP_VERSION=1.0.0
